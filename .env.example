# DeepSeek API 配置
# 在 https://platform.deepseek.com 申请 API Key,然后复制本文件为 .env.local 并填入
DEEPSEEK_API_KEY=
# 可选:覆盖默认值
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# RAG 向量检索:SiliconFlow(硅基流动)的 BGE-M3 embedding
# 在 https://siliconflow.cn 申请 key。配好后运行 `npm run build:index` 生成向量索引。
# 不配也能用,只是关闭 RAG 增强。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
